    "test:e2e:machine-critical-controls": "playwright test tests/e2e/hanzi-v2-run-complete-controls.spec.ts --config playwright.step07.config.ts --project=desktop-chromium",
    "test:e2e:machine-static-report": "playwright test tests/e2e/game-machine-static-report-scroll.spec.ts --config playwright.step07.config.ts --project=desktop-chromium",
    "test:e2e:hanzi-v2:step07": "playwright test tests/e2e/hanzi-v2-step07-real-second-use.spec.ts --config playwright.step07.config.ts",
    "test:e2e:hanzi-v2:step07:lifecycle": "playwright test tests/e2e/hanzi-v2-step07-lifecycle.spec.ts --config playwright.step07.config.ts --project=desktop-chromium",
    "test:hanzi-v2:step07:targeted-closure": "vitest run tests/hanzi-radical-battle-v2-step06-event-bridge.test.ts tests/hanzi-v2-step07-progress-gate.test.ts tests/hanzi-v2-step07-observer-schema.test.ts tests/observation-context.test.ts tests/game-machine-step07-lifecycle-evidence.test.ts tests/game-machine-deep-route-evidence.test.ts tests/game-machine-command-evidence.test.ts tests/game-machine-cleanup.test.ts tests/game-machine-readiness-package.test.ts && pnpm run test:e2e:hanzi-v2:step07:lifecycle",
    "test:e2e:machine-visual": "playwright test tests/e2e/game-machine-visual-regression.spec.ts --config playwright.step07.config.ts --project=desktop-chromium",
    "test:hanzi-v2:all-steps": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step02 && pnpm run test:hanzi-v2:step03 && pnpm run test:hanzi-v2:step04 && pnpm run test:hanzi-v2:step05 && pnpm run test:hanzi-v2:step06 && pnpm run test:hanzi-v2:step07",
    "validate:hanzi-v2:step07": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step07 && tsc --noEmit",
    "review:machine:games:hard": "pnpm run test:hanzi-v2:step07 && pnpm run test:e2e:adult-tools && pnpm run test:e2e:machine-games && pnpm run test:e2e:machine-deep-a11y && pnpm run test:e2e:machine-critical-controls",
    "review:machine:games:visual": "pnpm run test:e2e:machine-visual",
    "review:machine:evidence:compile": "tsx tools/game-machine-review/run-command-evidence.ts compile",
    "review:machine:evidence:targeted-tests": "tsx tools/game-machine-review/run-command-evidence.ts targeted-tests",
    "review:machine:evidence:step-regressions": "tsx tools/game-machine-review/run-command-evidence.ts step-regressions",
    "review:machine:evidence:full-tests": "tsx tools/game-machine-review/run-command-evidence.ts full-tests",
    "review:machine:evidence:build": "tsx tools/game-machine-review/run-command-evidence.ts build",
    "review:machine:evidence:visual-baseline-update": "tsx tools/game-machine-review/run-command-evidence.ts visual-baseline-update",
    "review:machine:evidence:visual-no-update": "tsx tools/game-machine-review/run-command-evidence.ts visual-no-update",
    "review:machine:evidence:promote-baseline": "tsx tools/game-machine-review/promote-visual-baseline.ts",
    "review:machine:games:semantic": "tsx tools/game-machine-review/run-machine-review.ts",
    "review:machine:games:report": "tsx tools/game-machine-review/run-machine-review.ts",
    "review:machine:games": "pnpm run review:machine:games:report",
    "finalize:machine:games": "tsx tools/game-machine-review/finalize-machine-evidence.ts",
    "package:machine:step07-readiness": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/game-machine-review/PACKAGE_STEP_07_MACHINE_READINESS.ps1",
    "review:machine:cleanup:plan": "tsx tools/game-machine-review/cleanup.ts plan .",
    "review:machine:cleanup:apply": "tsx tools/game-machine-review/cleanup.ts apply .",
    "review:machine:cleanup:verify": "tsx tools/game-machine-review/cleanup.ts verify .",
    "validate:machine:games": "pnpm run test:hanzi-v2:step07 && tsc --noEmit && pnpm run review:machine:games:report"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
