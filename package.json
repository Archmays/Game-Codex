    "test:hanzi-v2:step03": "vitest run tests/hanzi-radical-battle-v2-step03-manifest.test.ts tests/hanzi-radical-battle-v2-step03-hands.test.ts tests/hanzi-radical-battle-v2-step03-machine.test.ts tests/hanzi-radical-battle-v2-step03-abilities.test.ts tests/hanzi-radical-battle-v2-step03-boss.test.ts tests/hanzi-radical-battle-v2-step03-save.test.ts tests/hanzi-radical-battle-v2-step03-copy.test.ts tests/hanzi-radical-battle-v2-step03-review.test.ts tests/hanzi-radical-battle-v2-step03-guardrail.test.ts",
    "test:e2e:hanzi-v2:step03": "playwright test tests/e2e/hanzi-radical-battle-v2-step03.spec.ts",
