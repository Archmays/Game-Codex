{
  "name": "family-learning-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:equation-slider": "playwright test tests/e2e/equation-slider.spec.ts",
    "test:e2e:equation-slider:gate-a": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-a",
    "test:e2e:equation-slider:gate-c": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-c",
    "test:e2e:equation-slider:release": "playwright test tests/e2e/equation-slider-release.spec.ts",
    "test:e2e:equation-slider:visual": "playwright test tests/e2e/equation-slider-visual.spec.ts",
    "test:e2e:equation-slider:playtest": "playwright test tests/e2e/equation-slider-agent-playtest.spec.ts",
    "levels:generate": "tsx games/equation-slider/tools/generate-levels.ts",
    "levels:check": "tsx games/equation-slider/tools/generate-levels.ts --check",
    "validate:content": "vitest run tests/content-validation.test.ts",
    "play:my-game-world": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "play:hanzi-v2": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "test:hanzi-v2": "vitest run tests/hanzi-v2/chapter-one-core.test.ts tests/hanzi-v2/chapter-one-content.test.ts tests/hanzi-v2/chapter-one-builds.test.ts tests/hanzi-v2/chapter-one-persistence.test.ts tests/hanzi-v2/chapter-one-release-contract.test.ts tests/hanzi-v2/wheel-library.test.ts tests/hanzi-v2/wheel-machine.test.ts tests/hanzi-v2/v1-content.test.ts tests/hanzi-v2/v1-hands.test.ts tests/hanzi-v2/v1-machine.test.ts tests/hanzi-v2/v1-save.test.ts tests/hanzi-v2/v1-privacy-copy.test.ts",
    "test:hanzi-v2:chapter-one": "vitest run tests/hanzi-v2/chapter-one-core.test.ts tests/hanzi-v2/chapter-one-content.test.ts tests/hanzi-v2/chapter-one-builds.test.ts tests/hanzi-v2/chapter-one-persistence.test.ts tests/hanzi-v2/chapter-one-release-contract.test.ts tests/hanzi-v2/wheel-library.test.ts tests/hanzi-v2/wheel-machine.test.ts",
    "test:hanzi-v2:v1": "vitest run tests/hanzi-v2/v1-content.test.ts tests/hanzi-v2/v1-hands.test.ts tests/hanzi-v2/v1-machine.test.ts tests/hanzi-v2/v1-save.test.ts tests/hanzi-v2/v1-privacy-copy.test.ts",
    "test:e2e:hanzi-v2": "playwright test tests/e2e/hanzi-v2/chapter-one-core.spec.ts tests/e2e/hanzi-v2/chapter-one-content.spec.ts tests/e2e/hanzi-v2/chapter-one-builds.spec.ts tests/e2e/hanzi-v2/chapter-one-persistence.spec.ts tests/e2e/hanzi-v2/chapter-one-playthroughs.spec.ts tests/e2e/hanzi-v2/wheel-workshop.spec.ts --config playwright.chapter-one.config.ts",
    "test:e2e:hanzi-v2:wheel": "playwright test tests/e2e/hanzi-v2/wheel-workshop.spec.ts --config playwright.chapter-one.config.ts",
    "test:e2e:hanzi-v2:v1": "playwright test tests/e2e/hanzi-v2/v1-playthroughs.spec.ts --config playwright.v1.config.ts",
    "test:visual:hanzi-v2": "playwright test tests/e2e/hanzi-v2/chapter-one-visual.spec.ts --config playwright.chapter-one.config.ts --project=desktop-chromium --grep @visual",
    "test:geometry:hanzi-v2": "playwright test tests/e2e/hanzi-v2/chapter-one-visual.spec.ts --config playwright.chapter-one.config.ts --project=desktop-chromium --grep @hard-gates",
    "test:visual:hanzi-v2:v1": "playwright test tests/e2e/hanzi-v2/v1-visual.spec.ts --config playwright.v1.config.ts",
    "audit:hanzi-v2:wheel": "tsx tools/hanzi-v2-wheel-workshop/extract-legacy-wheel.ts --check && tsx tools/hanzi-v2-wheel-workshop/build-wheel-library.ts",
    "simulate:hanzi-v2:wheel": "tsx tools/hanzi-v2-wheel-workshop/simulate-wheel-workshop.ts 10000",
    "simulate:hanzi-v2": "tsx tools/hanzi-v2-chapter-one/scan-m5-release.ts 30000",
    "validate:hanzi-v2": "pnpm run audit:hanzi-v2:wheel && pnpm run test:hanzi-v2 && pnpm exec tsc --noEmit && pnpm run simulate:hanzi-v2 && pnpm run simulate:hanzi-v2:wheel",
    "verify:pages:hanzi-v2": "tsx tools/hanzi-v2-chapter-one/verify-pages.ts",
    "test:launcher:hanzi-v2": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/hanzi-v2-chapter-one/test-launcher-lifecycle.ps1",
    "source-hash:hanzi-v2": "tsx tools/hanzi-v2-chapter-one/source-identity.ts",
    "test:hanzi-complete:slices": "vitest run tests/hanzi-complete/vertical-slices.test.ts --no-file-parallelism",
    "test:e2e:hanzi-complete:slices": "playwright test tests/e2e/hanzi-complete/vertical-slices.spec.ts --config playwright.hanzi-complete.config.ts",
    "audit:hanzi-complete:content": "tsx tools/hanzi-magic-complete/build-m2-content.ts --check",
    "test:hanzi-complete:content": "vitest run tests/hanzi-complete/content-graph.test.ts --no-file-parallelism",
    "test:hanzi-complete:families": "vitest run tests/hanzi-complete/families.test.ts --no-file-parallelism",
    "test:hanzi-complete:words": "vitest run tests/hanzi-complete/words.test.ts --no-file-parallelism",
    "test:hanzi-complete:save": "vitest run tests/hanzi-complete/save.test.ts --no-file-parallelism",
    "test:hanzi-complete:legacy": "vitest run tests/hanzi-complete/legacy.test.ts --no-file-parallelism",
    "test:hanzi-complete": "vitest run tests/hanzi-complete --no-file-parallelism",
    "test:e2e:hanzi-complete:content": "playwright test tests/e2e/hanzi-complete/content-graph.spec.ts --config playwright.hanzi-complete.config.ts",
    "simulate:hanzi-complete": "tsx tools/hanzi-magic-complete/simulate-complete.ts",
    "test:e2e:hanzi-complete": "playwright test --config playwright.hanzi-complete.config.ts && playwright test --config playwright.hanzi-complete.acceptance.config.ts && tsx tools/hanzi-magic-complete/build-browser-matrix.ts",
    "test:visual:hanzi-complete": "playwright test --config playwright.hanzi-complete.visual.config.ts",
    "test:geometry:hanzi-complete": "playwright test --config playwright.hanzi-complete.visual.config.ts",
    "validate:hanzi-complete": "pnpm run audit:hanzi-complete:content && pnpm run test:hanzi-complete && pnpm run simulate:hanzi-complete && tsx tools/hanzi-magic-complete/review-complete.ts && pnpm exec tsc --noEmit",
    "verify:pages:hanzi-complete": "tsx tools/hanzi-magic-complete/verify-pages.ts",
    "test:launcher:hanzi-complete": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/hanzi-magic-complete/test-launcher-lifecycle.ps1",
    "source-hash:hanzi-complete": "tsx tools/hanzi-magic-complete/source-identity.ts",
    "package:hanzi-complete": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/hanzi-magic-complete/package-complete.ps1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
