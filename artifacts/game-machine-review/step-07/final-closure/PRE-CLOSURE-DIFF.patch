+      constructor(text = "") { super(); this.text = text; }
+    }
+    Object.defineProperty(window, "SpeechSynthesisUtterance", { configurable: true, value: CapturedUtterance });
+    Object.defineProperty(window, "speechSynthesis", {
+      configurable: true,
+      value: {
+        speaking: false,
+        pending: false,
+        paused: false,
