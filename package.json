    "test:e2e:hanzi-v2:step04": "playwright test tests/e2e/hanzi-radical-battle-v2-step04.spec.ts",
    "validate:hanzi-v2:step04": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step04 && tsc --noEmit",
    "capture:hanzi-v2:step04": "tsx tools/hanzi-v2-step04/capture-step04-readiness.ts",
    "package:hanzi-v2:step04-readiness": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/hanzi-v2-step04/PACKAGE_STEP_04_READINESS.ps1",
    "review:hanzi-v2:step05": "vite --host 127.0.0.1 --port 5176 --strictPort",
