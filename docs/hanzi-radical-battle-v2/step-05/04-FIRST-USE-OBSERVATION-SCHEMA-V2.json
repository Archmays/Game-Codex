{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family-games/hanzi-radical-battle-v2/step-05/child-first-use-observation-v2.schema.json",
  "title": "STEP 05 Child First-Use Observation Semantics v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "initiativeId", "step", "evidenceKind", "fixtureLabel",
    "sessionIdentity", "buildIdentity", "parentAuthorization", "audioPreflight",
    "technicalEvents", "observations", "interventions", "wellbeing",
    "optionalChildChoices", "replay", "completion", "privacyConfirmed",
    "observerNotes", "evidenceConsistencyWarnings"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "initiativeId": { "const": "hanzi-radical-battle-v2" },
    "step": { "const": "04" },
    "evidenceKind": { "enum": ["REAL_CHILD_OBSERVATION", "SYNTHETIC_TOOLING_TEST_ONLY"] },
    "fixtureLabel": {
      "oneOf": [
        { "type": "null" },
        { "const": "SYNTHETIC_FROM_SCHEMA_ONLY" }
      ]
    },
    "sessionIdentity": { "$ref": "#/$defs/sessionIdentity" },
    "buildIdentity": { "$ref": "#/$defs/buildIdentity" },
    "parentAuthorization": { "$ref": "#/$defs/parentAuthorization" },
    "audioPreflight": { "$ref": "#/$defs/audioPreflight" },
    "technicalEvents": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/technicalEvent" }
    },
    "observations": { "$ref": "#/$defs/observations" },
    "interventions": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/intervention" }
    },
    "wellbeing": { "$ref": "#/$defs/wellbeing" },
    "optionalChildChoices": { "$ref": "#/$defs/optionalChildChoices" },
    "replay": { "$ref": "#/$defs/replay" },
    "completion": { "$ref": "#/$defs/completion" },
    "privacyConfirmed": { "const": true },
    "observerNotes": { "type": "string", "maxLength": 1000 },
    "evidenceConsistencyWarnings": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidenceKind": { "const": "SYNTHETIC_TOOLING_TEST_ONLY" } } },
      "then": { "properties": { "fixtureLabel": { "const": "SYNTHETIC_FROM_SCHEMA_ONLY" } } },
      "else": { "properties": { "fixtureLabel": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sessionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "runSeed", "sessionMode", "startedAtUtc", "runCount"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^s04-[a-f0-9]{32}$" },
        "runSeed": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "sessionMode": { "enum": ["LIVE_DASHBOARD", "COMPACT_AFTER_SESSION"] },
        "startedAtUtc": { "type": "string", "format": "date-time" },
        "runCount": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "sourceSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encounters", "abilities", "boss", "themeC", "manifest"],
      "properties": {
        "encounters": { "const": "fnv1a:d805357d" },
        "abilities": { "const": "fnv1a:2d361817" },
        "boss": { "const": "fnv1a:ee5df70f" },
        "themeC": { "const": "fnv1a:15133968" },
        "manifest": { "const": "fnv1a:67ad1fe2" }
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "initiativeId", "step", "technicalState", "runtimeVersion",
        "audioContractVersion", "parentFeedbackSha256", "acceptedReviewIdentitySha256",
        "acceptedSourceSnapshots", "commitSha", "generatedAtUtc", "buildIdentitySha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "initiativeId": { "const": "hanzi-radical-battle-v2" },
        "step": { "const": "04" },
        "technicalState": { "const": "AUTHORIZED_CHILD_FIRST_USE_READY" },
        "runtimeVersion": { "const": "hanzi-v2-step04-runtime-v1" },
        "audioContractVersion": { "const": "hanzi-v2-step04-spoken-phrase-v1" },
        "parentFeedbackSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "acceptedReviewIdentitySha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "acceptedSourceSnapshots": { "$ref": "#/$defs/sourceSnapshots" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "generatedAtUtc": { "type": "string", "format": "date-time" },
        "buildIdentitySha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "parentAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "initiativeId", "step", "authorized", "authorizeChildFirstUse",
        "audioDecision", "parentFeedbackSha256", "acceptedReviewIdentitySha256", "checkedAtUtc"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "initiativeId": { "const": "hanzi-radical-battle-v2" },
        "step": { "const": "04" },
        "authorized": { "const": true },
        "authorizeChildFirstUse": { "const": "YES" },
        "audioDecision": { "const": "REVISE" },
        "parentFeedbackSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "acceptedReviewIdentitySha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "checkedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "phraseCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualPinyin", "spokenPhrase", "result"],
      "properties": {
        "visualPinyin": { "type": "string", "minLength": 1, "maxLength": 16 },
        "spokenPhrase": { "type": "string", "minLength": 5, "maxLength": 24 },
        "result": { "enum": ["HEARD_OK", "DISPLAY_ONLY_MUTED_OR_UNAVAILABLE"] }
      }
    },
    "audioPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "lang", "adapterStatus", "voiceCategory", "visualPinyinConfirmed", "phraseChecks"],
      "properties": {
        "decision": { "enum": ["SOUND_OK", "START_MUTED"] },
        "lang": { "const": "zh-CN" },
        "adapterStatus": { "enum": ["SPEECH_SYNTHESIS", "UNAVAILABLE"] },
        "voiceCategory": { "enum": ["ZH_CN_DEVICE_VOICE", "ZH_DEVICE_VOICE", "DEFAULT_DEVICE_VOICE", "NONE"] },
        "visualPinyinConfirmed": { "const": true },
        "phraseChecks": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/phraseCheck" } }
      }
    },
    "phase": {
      "enum": [
        "boot", "camp_intro", "camp_objective", "travel_to_battle_1", "battle_1_intro",
        "battle_1_placing", "battle_1_forming", "battle_1_casting", "battle_1_cleared",
        "breather_1", "travel_to_battle_2", "battle_2_intro", "battle_2_placing",
        "battle_2_forming", "battle_2_casting", "battle_2_cleared", "ability_choice",
        "travel_to_boss", "boss_intro", "boss_phase_1_placing", "boss_phase_1_forming",
        "boss_phase_1_cleared", "boss_phase_2_placing", "boss_phase_2_forming",
        "boss_cleared", "return_to_camp", "camp_repair", "spellbook_review", "run_complete",
        "invalid_feedback", "boss_interference", "paused", "settings_open", "safe_retry"
      ]
    },
    "stopCode": {
      "enum": ["CHILD_REQUEST", "DISTRESS", "SENSORY_DISCOMFORT", "TECHNICAL", "PRIVACY", "IDENTITY", "ADULT_ANSWER_REQUIRED", "OTHER"]
    },
    "technicalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sessionId", "sequence", "relativeMs", "eventType", "safeMetadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "type": "string", "pattern": "^s04-[a-f0-9]{32}$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "relativeMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "eventType": {
          "enum": [
            "session_opened", "child_route_ready", "first_action", "phase_entered",
            "invalid_placement", "built_in_hint_shown", "spell_formed",
            "meaning_magic_completed", "ability_selected", "boss_intent_shown",
            "boss_phase_completed", "camp_repaired", "spellbook_opened", "run_completed",
            "replay_selected", "session_stopped", "technical_error"
          ]
        },
        "safeMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": { "$ref": "#/$defs/phase" },
            "muted": { "type": "boolean" },
            "replayIndex": { "enum": [0, 1] },
            "actionKind": { "enum": ["pointer", "drag", "keyboard", "other"] },
            "encounterId": { "enum": ["encounter-ming", "encounter-hua", "boss-lin", "boss-xing"] },
            "hintLevel": { "enum": [1, 2] },
            "characterId": { "enum": ["ming", "hua", "lin", "xing"] },
            "abilityId": { "enum": ["guardian-light", "star-path", "ink-echo"] },
            "bossPhase": { "enum": ["lin", "xing"] },
            "origin": { "enum": ["spontaneous", "prompted"] },
            "stopCode": { "$ref": "#/$defs/stopCode" },
            "errorCode": { "enum": ["BRIDGE_UNAVAILABLE", "SESSION_INVALID", "RENDER_ERROR", "AUDIO_UNAVAILABLE", "LOCAL_STORAGE_UNAVAILABLE", "UNKNOWN_LOCAL_ERROR"] },
            "recoverable": { "type": "boolean" }
          }
        }
      }
    },
    "checkpointReach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstScreen", "firstSpell", "secondStructure", "abilityChoice", "bossIntent", "safeFailure", "campRepair", "spellbook"],
      "properties": {
        "firstScreen": { "$ref": "#/$defs/reachValue" }, "firstSpell": { "$ref": "#/$defs/reachValue" },
        "secondStructure": { "$ref": "#/$defs/reachValue" }, "abilityChoice": { "$ref": "#/$defs/reachValue" },
        "bossIntent": { "$ref": "#/$defs/reachValue" }, "safeFailure": { "$ref": "#/$defs/reachValue" },
        "campRepair": { "$ref": "#/$defs/reachValue" }, "spellbook": { "$ref": "#/$defs/reachValue" }
      }
    },
    "checkpointNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstScreen", "firstSpell", "secondStructure", "abilityChoice", "bossIntent", "safeFailure", "campRepair", "spellbook"],
      "properties": {
        "firstScreen": { "$ref": "#/$defs/noticeValue" }, "firstSpell": { "$ref": "#/$defs/noticeValue" },
        "secondStructure": { "$ref": "#/$defs/noticeValue" }, "abilityChoice": { "$ref": "#/$defs/noticeValue" },
        "bossIntent": { "$ref": "#/$defs/noticeValue" }, "safeFailure": { "$ref": "#/$defs/noticeValue" },
        "campRepair": { "$ref": "#/$defs/noticeValue" }, "spellbook": { "$ref": "#/$defs/noticeValue" }
      }
    },
    "reachValue": { "enum": ["REACHED", "NOT_REACHED", "STOPPED_BEFORE"] },
    "noticeValue": { "enum": ["UNRECORDED", "NOTICED_WITHOUT_PROMPT", "NOTICED_AFTER_BUILT_IN_SUPPORT", "NOTICED_AFTER_REGION_ONLY_PROMPT", "ADULT_ANSWER_REQUIRED", "STOPPED"] },
    "observationValue": { "enum": ["NOT_REACHED", "NOTICED_WITHOUT_PROMPT", "NOTICED_AFTER_BUILT_IN_SUPPORT", "NOTICED_AFTER_REGION_ONLY_PROMPT", "ADULT_ANSWER_REQUIRED", "STOPPED"] },
    "usabilityObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstAction", "boardCardSlotDistinction", "clickOrDrag", "abilityChoice", "bossIntent", "spellbookNavigation"],
      "properties": {
        "firstAction": { "$ref": "#/$defs/observationValue" },
        "boardCardSlotDistinction": { "$ref": "#/$defs/observationValue" },
        "clickOrDrag": { "$ref": "#/$defs/observationValue" },
        "abilityChoice": { "$ref": "#/$defs/observationValue" },
        "bossIntent": { "$ref": "#/$defs/observationValue" },
        "spellbookNavigation": { "$ref": "#/$defs/observationValue" }
      }
    },
    "engagementObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voluntarilyContinued", "noticedWorldChange", "replayedAudio", "spontaneousReplay"],
      "properties": {
        "voluntarilyContinued": { "$ref": "#/$defs/observationValue" },
        "noticedWorldChange": { "$ref": "#/$defs/observationValue" },
        "replayedAudio": { "$ref": "#/$defs/observationValue" },
        "spontaneousReplay": { "$ref": "#/$defs/observationValue" }
      }
    },
    "learningMechanismObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noticedMingComposition", "noticedStructureChange", "noticedMeaningChangedWorld", "connectedAbilityToBossSupport"],
      "properties": {
        "noticedMingComposition": { "$ref": "#/$defs/observationValue" },
        "noticedStructureChange": { "$ref": "#/$defs/observationValue" },
        "noticedMeaningChangedWorld": { "$ref": "#/$defs/observationValue" },
        "connectedAbilityToBossSupport": { "$ref": "#/$defs/observationValue" }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointReach", "checkpointNotice", "usability", "engagement", "learningMechanismVisibility"],
      "properties": {
        "checkpointReach": { "$ref": "#/$defs/checkpointReach" },
        "checkpointNotice": { "$ref": "#/$defs/checkpointNotice" },
        "usability": { "$ref": "#/$defs/usabilityObservations" },
        "engagement": { "$ref": "#/$defs/engagementObservations" },
        "learningMechanismVisibility": { "$ref": "#/$defs/learningMechanismObservations" }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "code", "region", "relativeMs"],
      "properties": {
        "checkpointId": { "enum": ["firstScreen", "firstSpell", "secondStructure", "abilityChoice", "bossIntent", "safeFailure", "campRepair", "spellbook"] },
        "code": { "enum": ["NONE", "REPEAT_VISIBLE_COPY", "POINT_TO_REGION_ONLY", "TECHNICAL_ASSIST", "ADULT_ANSWER_REQUIRED", "STOPPED"] },
        "region": { "oneOf": [{ "type": "null" }, { "enum": ["WORLD", "BOARD", "HAND"] }] },
        "relativeMs": { "type": "integer", "minimum": 0, "maximum": 3600000 }
      }
    },
    "wellbeing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comfortable", "briefConfusionRecovered", "sustainedFrustration", "sensoryDiscomfort", "childInitiatedStop", "feltForced", "stopCode"],
      "properties": {
        "comfortable": { "$ref": "#/$defs/wellbeingValue" }, "briefConfusionRecovered": { "$ref": "#/$defs/wellbeingValue" },
        "sustainedFrustration": { "$ref": "#/$defs/wellbeingValue" }, "sensoryDiscomfort": { "$ref": "#/$defs/wellbeingValue" },
        "childInitiatedStop": { "$ref": "#/$defs/wellbeingValue" }, "feltForced": { "$ref": "#/$defs/wellbeingValue" },
        "stopCode": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stopCode" }] }
      }
    },
    "wellbeingValue": { "enum": ["OBSERVED", "NOT_OBSERVED", "UNKNOWN"] },
    "optionalChildChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["againAgain", "favoriteMoment", "spontaneousReplay", "promptedReplay", "optionalQuestionsAsked"],
      "properties": {
        "againAgain": { "enum": ["AGAIN_NOW", "MAYBE_LATER", "STOP", "DECLINED", "NOT_ASKED"] },
        "favoriteMoment": { "enum": ["CAMP", "HANZI_MAGIC", "THREE_CHOICE", "BOSS", "SPELLBOOK", "NO_SELECTION", "NOT_ASKED"] },
        "spontaneousReplay": { "type": "boolean" }, "promptedReplay": { "type": "boolean" }, "optionalQuestionsAsked": { "type": "boolean" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replayIntent", "parentObservedReplayRequest", "actualReplayAction"],
      "properties": {
        "replayIntent": { "enum": ["AGAIN_NOW", "MAYBE_LATER", "STOP", "DECLINED", "NOT_ASKED"] },
        "parentObservedReplayRequest": { "enum": ["UNRECORDED", "OBSERVED", "NOT_OBSERVED"] },
        "actualReplayAction": { "type": "boolean" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childRouteLoaded", "runCompleted", "sessionStopped", "relativeDurationMs", "runCount", "stopCode"],
      "properties": {
        "childRouteLoaded": { "type": "boolean" }, "runCompleted": { "type": "boolean" },
        "sessionStopped": { "type": "boolean" }, "relativeDurationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
        "runCount": { "type": "integer", "minimum": 1, "maximum": 2 },
        "stopCode": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stopCode" }] }
      }
    }
  }
}
