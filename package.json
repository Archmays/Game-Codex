{
  "name": "family-learning-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:equation-slider": "playwright test tests/e2e/equation-slider.spec.ts",
    "test:e2e:equation-slider:gate-a": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-a",
    "test:e2e:equation-slider:gate-c": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-c",
    "test:e2e:equation-slider:release": "playwright test tests/e2e/equation-slider-release.spec.ts",
    "test:e2e:equation-slider:visual": "playwright test tests/e2e/equation-slider-visual.spec.ts",
    "test:e2e:equation-slider:playtest": "playwright test tests/e2e/equation-slider-agent-playtest.spec.ts",
    "levels:generate": "tsx games/equation-slider/tools/generate-levels.ts",
    "levels:check": "tsx games/equation-slider/tools/generate-levels.ts --check",
    "validate:content": "vitest run tests/math-world-target.test.ts tests/equation-slider-levels.test.ts",
    "play:my-game-world": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "portfolio:generate": "tsx tools/portfolio/generate-portfolio-docs.ts",
    "portfolio:check": "tsx tools/portfolio/check-portfolio.ts",
    "portfolio:evolution:generate": "tsx tools/portfolio/generate-portfolio-evolution.ts",
    "portfolio:evolution:check": "tsx tools/portfolio/check-portfolio-evolution.ts",
    "test:portfolio:smoke": "playwright test --config playwright.portfolio.config.ts",
    "test:portfolio:affected": "tsx tools/portfolio/affected-gates.ts",
    "validate:play-readiness": "tsx tools/play-readiness/validate-play-readiness.ts",
    "test:play-readiness": "vitest run tests/play-readiness --no-file-parallelism",
    "test:e2e:play-readiness": "playwright test tests/e2e/play-readiness/portfolio.spec.ts --config playwright.play-readiness.config.ts --grep \"@play-ready|@long-session\"",
    "test:e2e:play-readiness:smoke": "playwright test tests/e2e/play-readiness/portfolio.spec.ts --config playwright.play-readiness.config.ts --grep @play-ready --project=desktop-1440 --project=mobile-390",
    "validate:interaction-integrity": "tsx tools/interaction-integrity/validate-interaction-integrity.ts",
    "test:e2e:hittest": "playwright test --config playwright.interaction-integrity.config.ts",
    "test:e2e:hittest:representative": "playwright test --config playwright.interaction-integrity.config.ts --project=desktop-1366 --project=mobile-390 --grep @representative",
    "validate:scroll-integrity": "tsx tools/scroll-integrity/validate-scroll-integrity.ts",
    "test:e2e:scroll-reachability": "playwright test --config playwright.scroll-reachability.config.ts",
    "test:e2e:scroll-reachability:representative": "playwright test --config playwright.scroll-reachability.config.ts --project=desktop-1366 --project=mobile-390 --grep @representative",
    "validate:play-surface-integrity": "pnpm run validate:interaction-integrity && pnpm run validate:scroll-integrity",
    "verify:pages:interaction-integrity": "tsx tools/interaction-integrity/verify-pages.ts",
    "verify:pages:scroll-reachability": "tsx tools/scroll-integrity/verify-pages.ts",
    "reports:stable-natural-use-entry": "tsx tools/scroll-integrity/build-release-reports.ts",
    "package:stable-natural-use-entry": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/scroll-integrity/package-return.ps1",
    "capture:natural-use-status": "tsx tools/scroll-integrity/capture-lifecycle-status.ts",
    "reports:interaction-integrity": "tsx tools/interaction-integrity/build-release-reports.ts",
    "package:interaction-integrity": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/interaction-integrity/package-return.ps1",
    "test:a11y:play-readiness": "playwright test tests/e2e/play-readiness/portfolio.spec.ts --config playwright.play-readiness.config.ts --grep @a11y",
    "test:save-vault": "vitest run tests/save-vault --no-file-parallelism && playwright test tests/e2e/play-readiness/portfolio.spec.ts --config playwright.play-readiness.config.ts --grep @save-vault --project=desktop-1440 --project=mobile-390",
    "test:natural-use-kit": "vitest run tests/natural-use-kit --no-file-parallelism",
    "test:e2e:natural-use-kit": "playwright test tests/e2e/natural-use-kit/observation.spec.ts --config playwright.natural-use.config.ts",
    "test:privacy:natural-use-kit": "vitest run tests/natural-use-kit/schema-store.test.ts --no-file-parallelism && tsx tools/natural-use/check-runtime-privacy.ts",
    "validate:natural-use-bundle": "tsx tools/natural-use/validate-observation-bundle.ts",
    "summarize:natural-use-bundle": "tsx tools/natural-use/summarize-observation-bundle.ts",
    "verify:pages:natural-use-kit": "tsx tools/natural-use/verify-pages.ts",
    "reports:natural-use-kit": "tsx tools/natural-use/build-release-reports.ts",
    "package:natural-use-kit": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/natural-use/package-return.ps1",
    "test:performance:portfolio": "playwright test --config playwright.performance.config.ts",
    "test:visual:play-readiness": "playwright test tests/e2e/play-readiness/portfolio.spec.ts --config playwright.play-readiness.config.ts --grep @visual --project=desktop-1440 --project=mobile-390",
    "verify:pages:play-readiness": "tsx tools/play-readiness/verify-pages.ts",
    "reports:play-readiness": "tsx tools/play-readiness/build-release-reports.ts",
    "package:play-readiness": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/play-readiness/package-return.ps1",
    "test:math-world": "vitest run tests/math-world-target.test.ts tests/math-world-shell.test.ts tests/portfolio-retirement.test.ts --no-file-parallelism",
    "test:math-world:target": "vitest run tests/math-world-target.test.ts --no-file-parallelism",
    "test:math-world:save": "vitest run tests/math-world-shell.test.ts tests/portfolio-retirement.test.ts --no-file-parallelism",
    "test:math-world:content": "vitest run tests/math-world-target.test.ts --no-file-parallelism",
    "test:e2e:math-world": "playwright test tests/e2e/math-world.spec.ts tests/e2e/math-world-retirement.spec.ts tests/e2e/math-world-workbench.spec.ts --config playwright.math-world.config.ts --project=desktop-1440 --project=mobile-390 --project=tablet-768",
    "test:visual:math-world": "playwright test tests/e2e/math-world-visual.spec.ts --config playwright.math-world.config.ts --grep @visual --project=desktop-1440 --project=mobile-390 --project=tablet-768",
    "test:geometry:math-world": "playwright test tests/e2e/math-world-visual.spec.ts --config playwright.math-world.config.ts --grep @geometry",
    "validate:math-world": "tsx tools/math-world/validate-math-world.ts",
    "verify:pages:math-world": "tsx tools/math-world/verify-pages.ts",
    "maintenance:inventory": "tsx tools/maintenance/repository-maintenance.ts inventory",
    "maintenance:cleanup": "tsx tools/maintenance/repository-maintenance.ts cleanup",
    "maintenance:verify": "tsx tools/maintenance/repository-maintenance.ts verify",
    "maintenance:close-task": "tsx tools/maintenance/repository-maintenance.ts close-task",
    "test:hanzi-tower-defense": "vitest run tests/hanzi-tower-defense.test.ts --no-file-parallelism",
    "validate:hanzi-tower-defense": "tsx tools/hanzi-tower-defense/validate-balance.ts",
    "test:e2e:hanzi-tower-defense": "playwright test --config playwright.hanzi-tower-defense.config.ts",
    "test:memory-match": "vitest run tests/memory-match.test.ts tests/memory-match-save.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
