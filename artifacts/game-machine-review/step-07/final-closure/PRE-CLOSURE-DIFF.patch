+      <label>独立时段间隔<select data-interval><option value="">请选择</option>${optionsMarkup(STEP06_INTERVAL_BUCKETS)}</select></label>
+      <label>声音方式<select data-sound>${optionsMarkup(STEP06_SOUND_MODES)}</select></label>
