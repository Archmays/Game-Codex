{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmays.github.io/Game-Codex/schemas/hanzi-v2-chapter-one-working-state.schema.json",
  "title": "Hanzi Magic Battle V2 Chapter One working state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationId", "targetVersion", "activeMilestone", "completedMilestones", "status", "updatedAtUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorizationId": { "const": "HUMAN_AUTHORIZED_CONTINUOUS_V1_TO_V2_CHAPTER_ONE_20260813" },
    "targetVersion": { "const": "V2.0.0" },
    "activeMilestone": { "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "FINAL", "COMPLETE"] },
    "completedMilestones": { "type": "array", "uniqueItems": true, "items": { "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "FINAL"] } },
    "status": { "enum": ["IN_PROGRESS", "PASS_STAGE", "AUTO_REVISE", "ESCALATE_HUMAN", "PASS_MACHINE"] },
    "latestGatePath": { "type": ["string", "null"] },
    "sourceCommit": { "type": "string", "pattern": "^(WORKTREE|[0-9a-f]{40})$" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "updatedAtUtc": { "type": "string", "format": "date-time" }
  }
}
