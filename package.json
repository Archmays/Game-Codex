{
  "name": "family-learning-games",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:equation-slider": "playwright test tests/e2e/equation-slider.spec.ts",
    "test:e2e:equation-slider:gate-a": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-a",
    "test:e2e:equation-slider:gate-c": "playwright test tests/e2e/equation-slider.spec.ts --grep @gate-c",
    "test:e2e:equation-slider:release": "playwright test tests/e2e/equation-slider-release.spec.ts",
    "test:e2e:equation-slider:visual": "playwright test tests/e2e/equation-slider-visual.spec.ts",
    "test:e2e:equation-slider:playtest": "playwright test tests/e2e/equation-slider-agent-playtest.spec.ts",
    "levels:generate": "tsx games/equation-slider/tools/generate-levels.ts",
    "levels:check": "tsx games/equation-slider/tools/generate-levels.ts --check",
    "validate:content": "vitest run tests/content-validation.test.ts",
    "validate:hanzi-v2-foundation": "vitest run tests/hanzi-radical-battle-v2-foundation.test.ts",
    "review:hanzi-v2:step02": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test:hanzi-v2:step02": "vitest run tests/hanzi-radical-battle-v2-step02-structure.test.ts tests/hanzi-radical-battle-v2-step02-content.test.ts tests/hanzi-radical-battle-v2-step02-save.test.ts tests/hanzi-radical-battle-v2-step02-copy.test.ts tests/hanzi-radical-battle-v2-step02-review.test.ts",
    "test:e2e:hanzi-v2:step02": "playwright test tests/e2e/hanzi-radical-battle-v2-step02.spec.ts",
    "validate:hanzi-v2:step02": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step02",
    "play:hanzi-v2:step03": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "review:hanzi-v2:step03": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test:hanzi-v2:step03": "vitest run tests/hanzi-radical-battle-v2-step03-manifest.test.ts tests/hanzi-radical-battle-v2-step03-hands.test.ts tests/hanzi-radical-battle-v2-step03-machine.test.ts tests/hanzi-radical-battle-v2-step03-abilities.test.ts tests/hanzi-radical-battle-v2-step03-boss.test.ts tests/hanzi-radical-battle-v2-step03-save.test.ts tests/hanzi-radical-battle-v2-step03-copy.test.ts tests/hanzi-radical-battle-v2-step03-review.test.ts tests/hanzi-radical-battle-v2-step03-guardrail.test.ts",
    "test:e2e:hanzi-v2:step03": "playwright test tests/e2e/hanzi-radical-battle-v2-step03.spec.ts",
    "validate:hanzi-v2:step03": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step03 && tsc --noEmit",
    "capture:hanzi-v2:step03": "tsx tools/hanzi-v2-step03/capture-step03.ts",
    "observe:hanzi-v2:step04": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "test:hanzi-v2:step04": "vitest run tests/hanzi-radical-battle-v2-step04-audio.test.ts tests/hanzi-radical-battle-v2-step04-freeze.test.ts tests/hanzi-radical-battle-v2-step04-observer-schema.test.ts tests/hanzi-radical-battle-v2-step04-event-bridge.test.ts tests/hanzi-radical-battle-v2-step04-privacy.test.ts tests/hanzi-radical-battle-v2-step04-gate.test.ts tests/hanzi-radical-battle-v2-step04-copy.test.ts",
    "test:e2e:hanzi-v2:step04": "playwright test tests/e2e/hanzi-radical-battle-v2-step04.spec.ts",
    "validate:hanzi-v2:step04": "pnpm run validate:hanzi-v2-foundation && pnpm run test:hanzi-v2:step04 && tsc --noEmit",
    "capture:hanzi-v2:step04": "tsx tools/hanzi-v2-step04/capture-step04-readiness.ts",
    "package:hanzi-v2:step04-readiness": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/hanzi-v2-step04/PACKAGE_STEP_04_READINESS.ps1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
